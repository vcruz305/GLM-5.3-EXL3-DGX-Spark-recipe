# The measured fast path (default). Sourced by env.sh before its defaults; an exported variable still wins.
# --context 163840 with the whole bf16 KV cache on every rank (TF_GLM53_DCP=1): the same code path and greedy ids as
# the 32K sweep. 163840 is the largest multiple of 8192 whose predicted minimum MemAvailable stays >= 5 GiB on every
# rank (97,344 B per cached token per rank); measured session minimum 4.86 GiB on the tightest rank, swap growth 0.
PROFILE_VALIDATED=1
TFS_CONTEXT="${TFS_CONTEXT:-163840}"
TF_GLM53_DCP="${TF_GLM53_DCP:-1}"
TFS_KV_DTYPE="${TFS_KV_DTYPE:-bf16}"
BENCH_IDS="${BENCH_IDS:-reference}"     # bench: every reply must equal the pinned reference ids (bench/sweep_reference.json)
