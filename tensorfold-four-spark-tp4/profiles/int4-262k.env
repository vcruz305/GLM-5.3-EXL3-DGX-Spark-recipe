# 262,144 tokens, whole cache on every rank (TF_GLM53_DCP=1), with an int4 MLA latent cache: exllamav3's Q4 cache format
# (the 512-wide latent in 32-value groups with fp16 scales; RoPE dims and indexer keys stay 16-bit), 9.234 GiB a rank.
# Runtime: vcruz305/TensorFold glm53-kv-int4 @ 0c858e3 (TF_INT4_REF in env.sh), which setup.sh installs next to the
# default tree, so switching profiles needs no reinstall. int4 changes the numerics: its greedy ids are not the bf16
# ids (drafted == this server's own serial still holds), and the pack's quality figures do not carry over.
#
# Measured 2026-10-05 on four Sparks through a copy of this folder's lib/ (not through these entry scripts, so every
# figure is TODO(confirm)): 6-prompt DFlash2 mean 40.62 tok/s, serial 25.3, drafted == serial 18/18, SixCat decode p50
# 68.18 / prefill p50 307.9 tok/s; MemAvailable >= 10.18 GiB while serving, 6.35 GiB during a first boot's kernel builds.
# Records: bench/records/2026-10-05-serve-262k-int4/.
#
# NOT VALIDATED: opt-in (ALLOW_UNVALIDATED=1) until its quality gate finishes. The default profile is always validated:
# making this profile the default is the one DEFAULT_PROFILE line in env.sh.
PROFILE_VALIDATED=0
PROFILE_NOTE="quality gate not finished: prompt path PASS on 160 rows, decode path pending; speed TODO(confirm)"
TF_REF="${TF_REF:-$TF_INT4_REF}"
TFS_CONTEXT="${TFS_CONTEXT:-262144}"
TF_GLM53_DCP="${TF_GLM53_DCP:-1}"
TFS_KV_DTYPE="${TFS_KV_DTYPE:-int4}"
TF_GLM53_KV_RCP="${TF_GLM53_KV_RCP:-approx}"   # 1/s as exllamav3's fast-math build computes it (bit-identical writer)
TF_GLM53_KV_TILE="${TF_GLM53_KV_TILE:-fp16}"   # attention tiles over dequantized keys in fp16 (exllamav3's precision)
# the int4 tree's kernels build into private caches, never the shared ~/.cache/torch_extensions
TORCH_EXTENSIONS_DIR="${TORCH_EXTENSIONS_DIR:-${RECIPE_HOME:-$HOME/glm53-tensorfold}/torch_extensions-int4}"
TRITON_CACHE_DIR="${TRITON_CACHE_DIR:-${RECIPE_HOME:-$HOME/glm53-tensorfold}/triton_cache-int4}"
export TF_GLM53_KV_RCP TF_GLM53_KV_TILE TORCH_EXTENSIONS_DIR TRITON_CACHE_DIR
BENCH_IDS="${BENCH_IDS:-self}"          # bench: drafted == this server's own "draft": false ids (int4 ids are not bf16's)
