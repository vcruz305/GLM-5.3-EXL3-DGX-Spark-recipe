# PENDING VALIDATION - opt-in only. 262,144 tokens, whole cache on every rank, with an int4 MLA latent cache
# (exllamav3's Q4 cache format: the 512-wide latent in 32-value groups with fp16 scales; RoPE dims and indexer keys stay
# 16-bit). Needs the vcruz305/TensorFold glm53-kv-int4 branch, which setup.sh builds into its own checkout when this
# profile is selected. CPU-validated only (writer bit-identical to exllamav3's quantizer, row-invariant readers); no
# speed, memory or quality figure exists on a Spark yet. int4 changes the numerics: its replies are not the bf16 ids.
# Predicted (not measured): 9.23 GiB of cache per rank at 262,144.
PROFILE_VALIDATED=0
TF_REF="${TF_REF:-47c7aa058f6d262b0a859f629c649780e0365515}"
TFS_CONTEXT="${TFS_CONTEXT:-262144}"
TF_GLM53_DCP="${TF_GLM53_DCP:-1}"
TFS_KV_DTYPE="${TFS_KV_DTYPE:-int4}"
TF_GLM53_KV_RCP="${TF_GLM53_KV_RCP:-approx}"   # 1/s as exllamav3's fast-math build computes it
TF_GLM53_KV_TILE="${TF_GLM53_KV_TILE:-fp16}"   # attention tiles over dequantized keys in fp16 (exllamav3's precision)
# the patched tree's kernels build into private caches, never the shared ~/.cache/torch_extensions
TORCH_EXTENSIONS_DIR="${TORCH_EXTENSIONS_DIR:-${RECIPE_HOME:-$HOME/glm53-tensorfold}/torch_extensions-int4}"
TRITON_CACHE_DIR="${TRITON_CACHE_DIR:-${RECIPE_HOME:-$HOME/glm53-tensorfold}/triton_cache-int4}"
export TF_GLM53_KV_RCP TF_GLM53_KV_TILE TORCH_EXTENSIONS_DIR TRITON_CACHE_DIR
BENCH_IDS="${BENCH_IDS:-self}"
